{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  enabledManagers: [
    'github-actions',
  ],
  extends: [
    'config:recommended',
  ],
  timezone: 'Etc/UTC',
  schedule: [
    '* 6-7 * * 1',
  ],
  labels: [
    'dependencies',
  ],
  prConcurrentLimit: 1,
  dependencyDashboard: {
    enabled: true,
  },
  packageRules: [
    {
      matchManagers: [
        'github-actions',
      ],
      groupName: 'actions',
    },
    {
      matchPackageNames: [
        'python',
        'java',
        'java-jdk',
      ],
      enabled: false,
    },
  ],
}
